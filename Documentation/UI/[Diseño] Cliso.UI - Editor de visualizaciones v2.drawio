        <mxCell id="mc-card-ico" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FF0000;strokeColor=#FFFFFF;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" value="◉" vertex="1">
