        <mxCell id="btn-discard" parent="1" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry x="996" y="622" width="24" height="24" as="geometry" />
        </mxCell>

        <mxCell id="notes" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#16181C;strokeColor=#2F3336;fontColor=#E7E9EA;" value="&lt;b&gt;Añadir un usuario&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Añadir&lt;/b&gt; deja el detalle en blanco y en edición, con el rol de menos permisos (Visor). Es el único momento en que se escribe el &lt;b&gt;nombre de usuario&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Se piden &lt;b&gt;Contraseña&lt;/b&gt; y &lt;b&gt;Repetir contraseña&lt;/b&gt;; cada campo tiene su botón de icono (ojo, con tooltip) para verla u ocultarla.&lt;br&gt;&lt;br&gt;Al guardar, los campos obligatorios vacíos y la repetición que no coincide se avisan bajo cada campo en --color-danger.&lt;br&gt;&lt;br&gt;Si el API rechaza la contraseña, se listan en --color-danger los requisitos que no cumple («La contraseña debe:» …). Un nombre de usuario repetido se avisa con un toast." vertex="1">
          <mxGeometry x="1120" y="20" width="400" height="380" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Usuarios (cambiar contraseña)" id="usuarios-contrasena">
    <mxGraphModel background="#000000" dx="1178" dy="654" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="620" math="0" shadow="0">
