        </mxCell>
        <mxCell id="sub-accept" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#000000;" value="Aceptar" vertex="1">
          <mxGeometry x="628" y="372" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="notes" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#16181C;strokeColor=#2F3336;fontColor=#E7E9EA;" value="&lt;b&gt;Cambiar la contraseña&lt;/b&gt;&lt;br&gt;&lt;br&gt;Al editar un usuario existente no hay campos de contraseña: casi siempre se cambian solo sus datos. Bajo el rol aparece el botón secundario &lt;b&gt;Cambiar contraseña&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Abre un &lt;b&gt;submodal&lt;/b&gt; (24 rem de ancho, limitado en pantallas estrechas) que la pide dos veces, cada campo con su ojo. &lt;b&gt;Aceptar&lt;/b&gt; comprueba que no esté vacía y que coincidan; &lt;b&gt;Cancelar&lt;/b&gt;, Escape o un clic fuera la dejan como estaba.&lt;br&gt;&lt;br&gt;La contraseña nueva no se envía al aceptar, sino con el resto de datos al pulsar &lt;b&gt;Guardar&lt;/b&gt;; mientras tanto, un texto secundario lo recuerda bajo el botón." vertex="1">
          <mxGeometry x="1120" y="20" width="400" height="360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
