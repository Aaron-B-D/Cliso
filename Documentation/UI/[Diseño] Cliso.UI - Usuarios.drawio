        </mxCell>
        <mxCell id="sub-cancel" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2F3336;fontSize=15;fontColor=#E7E9EA;" value="Cancelar" vertex="1">
