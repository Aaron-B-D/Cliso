        </mxCell>
        <mxCell id="sub-password" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#2F3336;align=left;spacingLeft=16;fontSize=15;fontColor=#E7E9EA;" value="••••••••••" vertex="1">
          <mxGeometry x="412" y="212" width="336" height="52" as="geometry" />
        </mxCell>
        <mxCell id="sub-password-label" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#71767B;fillColor=#16181C;" value="Contraseña" vertex="1">
          <mxGeometry x="424" y="204" width="68" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sub-password-eye" parent="1" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry x="712" y="226" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sub-repeat" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#2F3336;align=left;spacingLeft=16;fontSize=15;fontColor=#E7E9EA;" value="••••••••••" vertex="1">
