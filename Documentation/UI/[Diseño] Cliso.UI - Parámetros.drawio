          <mxGeometry x="120" y="124" width="920" height="1" as="geometry" />
        </mxCell>

        <!-- Selector: buscador y botón de plegar -->
        <mxCell id="search" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#2F3336;align=left;spacingLeft=12;fontSize=14;fontColor=#71767B;" value="⌕&amp;nbsp;&amp;nbsp;Buscar parámetro" vertex="1">
          <mxGeometry x="136" y="141" width="232" height="40" as="geometry" />
