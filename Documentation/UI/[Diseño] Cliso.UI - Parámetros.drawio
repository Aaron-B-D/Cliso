          <mxGeometry x="372" y="145" width="28" height="32" as="geometry" />
        </mxCell>

        <!-- Selector: fichas de parámetros (ordenadas por nombre; la lista se desplaza si no caben) -->
        <mxCell id="card-1" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#16181C;strokeColor=#2F3336;shadow=1;" value="" vertex="1">
          <mxGeometry x="136" y="197" width="252" height="60" as="geometry" />
        </mxCell>
        <mxCell id="card-1-name" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#E7E9EA;" value="Caducidad de la sesión" vertex="1">
          <mxGeometry x="148" y="207" width="228" height="20" as="geometry" />
        </mxCell>
        <mxCell id="card-1-value" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#71767B;" value="1800000" vertex="1">
          <mxGeometry x="148" y="227" width="228" height="20" as="geometry" />
        </mxCell>
        <mxCell id="card-2" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#1D1F23;strokeColor=#2F3336;shadow=1;" value="" vertex="1">
          <mxGeometry x="136" y="265" width="252" height="60" as="geometry" />
        </mxCell>
        <mxCell id="card-2-name" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#E7E9EA;" value="Carpeta de modelos BIM" vertex="1">
          <mxGeometry x="148" y="275" width="228" height="20" as="geometry" />
        </mxCell>
        <mxCell id="card-2-value" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#71767B;" value="data/models" vertex="1">
          <mxGeometry x="148" y="295" width="228" height="20" as="geometry" />
        </mxCell>
