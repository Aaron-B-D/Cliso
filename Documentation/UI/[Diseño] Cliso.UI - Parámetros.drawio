        <mxCell id="splitter" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F3336;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="404" y="125" width="2" height="299" as="geometry" />
        </mxCell>

        <!-- Detalle: parámetro abierto, con el panel de su tipo (aquí, el de texto libre) -->
        <mxCell id="detail-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#E7E9EA;" value="Carpeta de modelos BIM" vertex="1">
          <mxGeometry x="424" y="141" width="592" height="32" as="geometry" />
        </mxCell>
        <mxCell id="detail-description" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#E7E9EA;" value="Carpeta donde se guardan los ficheros IFC de los modelos BIM (relativa a Cliso.API si no es absoluta)." vertex="1">
          <mxGeometry x="424" y="177" width="592" height="40" as="geometry" />
        </mxCell>
        <mxCell id="detail-observations" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#71767B;" value="Se lee al arrancar la API: un cambio requiere reiniciarla y los ficheros ya subidos no se mueven." vertex="1">
          <mxGeometry x="424" y="221" width="592" height="20" as="geometry" />
        </mxCell>
        <mxCell id="field" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#2F3336;align=left;spacingLeft=16;fontSize=15;fontColor=#E7E9EA;" value="data/models" vertex="1">
          <mxGeometry x="424" y="253" width="544" height="52" as="geometry" />
        </mxCell>
        <mxCell id="field-label" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#71767B;fillColor=#16181C;" value="Valor" vertex="1">
          <mxGeometry x="436" y="245" width="40" height="16" as="geometry" />
        </mxCell>
        <mxCell id="restore" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=22;fontColor=#E7E9EA;" value="↻" vertex="1">
          <mxGeometry x="976" y="257" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="restore-tooltip" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#16181C;strokeColor=#2F3336;fontSize=11;fontColor=#E7E9EA;" value="Restaurar el valor por defecto" vertex="1">
          <mxGeometry x="828" y="309" width="192" height="24" as="geometry" />
        </mxCell>
        <mxCell id="detail-default" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#71767B;" value="Valor por defecto: data/models" vertex="1">
          <mxGeometry x="424" y="313" width="380" height="20" as="geometry" />
        </mxCell>

        <!-- Pie: sin Añadir ni Borrar; solo Editar (y Guardar y Descartar al editar) -->
        <mxCell id="footer-line" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F3336;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="120" y="424" width="920" height="1" as="geometry" />
        </mxCell>
        <mxCell id="btn-edit" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;fontColor=#E7E9EA;" value="✎" vertex="1">
          <mxGeometry x="988" y="432" width="32" height="32" as="geometry" />
        </mxCell>

        <!-- Notas -->
        <mxCell id="notes" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#16181C;strokeColor=#2F3336;fontColor=#E7E9EA;" value="&lt;b&gt;Editor de parámetros&lt;/b&gt;&lt;br&gt;&lt;br&gt;Entrada &lt;b&gt;Parámetros&lt;/b&gt; del panel de Edición, solo para quien puede modificarlos. Mismo modal que los demás editores, pero sin &lt;b&gt;Añadir&lt;/b&gt; ni &lt;b&gt;Borrar&lt;/b&gt;: los parámetros son fijos. Su alto inicial es menor (26 rem).&lt;br&gt;&lt;br&gt;La lista tiene un parámetro por ficha (nombre y valor actual). El detalle muestra su descripción, sus observaciones y el valor por defecto, y un &lt;b&gt;panel propio según el tipo&lt;/b&gt;: texto libre (carpeta), número (intervalo y caducidad de la sesión, un panel compartido) o lista de idiomas.&lt;br&gt;&lt;br&gt;El campo ocupa todo el ancho que deja el botón &lt;b&gt;↻&lt;/b&gt;, que pone el valor por defecto (solo al editar) y lleva tooltip.&lt;br&gt;&lt;br&gt;Al guardar, los números deben ser enteros mayores que cero y la carpeta no puede quedar vacía; el resto lo valida el API." vertex="1">
          <mxGeometry x="1120" y="20" width="400" height="400" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Parámetros (aviso al guardar)" id="parametros-aviso">
    <mxGraphModel background="#000000" dx="1178" dy="654" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="backdrop" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;opacity=32;strokeColor=#2F3336;" value="" vertex="1">
          <mxGeometry x="40" y="40" width="720" height="360" as="geometry" />
        </mxCell>
        <mxCell id="dialog" parent="1" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#16181C;strokeColor=#2F3336;" value="" vertex="1">
          <mxGeometry x="180" y="130" width="440" height="170" as="geometry" />
        </mxCell>
        <mxCell id="message" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=15;fontColor=#E7E9EA;" value="Los cambios solo se aplicarán cuando recargues la página. Este parámetro, además, requiere reiniciar la API." vertex="1">
          <mxGeometry x="204" y="154" width="392" height="80" as="geometry" />
        </mxCell>
        <mxCell id="accept" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;fontSize=15;fontStyle=1;fontColor=#000000;" value="Aceptar" vertex="1">
          <mxGeometry x="472" y="244" width="124" height="40" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#16181C;strokeColor=#2F3336;fontColor=#E7E9EA;" value="&lt;b&gt;Aviso tras guardar&lt;/b&gt;&lt;br&gt;&lt;br&gt;Diálogo de confirmación de tipo &lt;b&gt;informativo&lt;/b&gt;: solo el botón &lt;b&gt;Aceptar&lt;/b&gt;, sin cancelar. Se muestra tras guardar un parámetro, junto a un aviso de éxito.&lt;br&gt;&lt;br&gt;El front no aplica el valor nuevo: lo recupera del API al recargar la página.&lt;br&gt;&lt;br&gt;La carpeta de modelos y la caducidad de la sesión las lee la API al arrancar, así que añaden la segunda frase: hay que reiniciarla." vertex="1">
          <mxGeometry x="800" y="40" width="360" height="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
