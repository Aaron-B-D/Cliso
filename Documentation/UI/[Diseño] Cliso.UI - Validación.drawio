        <mxCell id="a-btn-maximize" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;fontColor=#E7E9EA;" value="☐" vertex="1">
          <mxGeometry x="956" y="76" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="a-btn-close" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;fontColor=#E7E9EA;" value="✕" vertex="1">
          <mxGeometry x="992" y="76" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="a-header-line" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F3336;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="120" y="124" width="920" height="1" as="geometry" />
        </mxCell>

        <!-- Selector (resumido) -->
        <mxCell id="a-search" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#2F3336;align=left;spacingLeft=12;fontSize=14;fontColor=#71767B;" value="⌕&amp;nbsp;&amp;nbsp;Buscar usuarios" vertex="1">
          <mxGeometry x="136" y="141" width="232" height="40" as="geometry" />
