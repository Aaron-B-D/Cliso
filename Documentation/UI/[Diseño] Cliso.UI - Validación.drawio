  <diagram name="Validación - Usuarios (panel abierto)" id="validacion-usuarios-abierto">
    <mxGraphModel background="#000000" dx="1178" dy="654" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Fondo oscurecido (backdrop del mat-dialog) -->
