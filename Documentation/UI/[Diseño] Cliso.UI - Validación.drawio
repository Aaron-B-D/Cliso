          <mxGeometry x="372" y="145" width="28" height="32" as="geometry" />
        </mxCell>
        <mxCell id="a-splitter" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F3336;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="404" y="125" width="2" height="643" as="geometry" />
        </mxCell>

        <!-- Detalle: los campos que incumplen una regla llevan borde y etiqueta en rojo, sin texto de error propio -->
        <mxCell id="a-field-nick" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#F4212E;align=left;spacingLeft=16;fontSize=15;fontColor=#E7E9EA;" value="" vertex="1">
          <mxGeometry x="424" y="153" width="592" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a-field-nick-label" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#F4212E;fillColor=#16181C;" value="Nombre de usuario" vertex="1">
          <mxGeometry x="436" y="145" width="108" height="16" as="geometry" />
        </mxCell>
        <mxCell id="a-field-name" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#F4212E;align=left;spacingLeft=16;fontSize=15;fontColor=#E7E9EA;" value="" vertex="1">
          <mxGeometry x="424" y="221" width="592" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a-field-name-label" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#F4212E;fillColor=#16181C;" value="Nombre" vertex="1">
          <mxGeometry x="436" y="213" width="52" height="16" as="geometry" />
        </mxCell>
        <mxCell id="a-field-surname" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#2F3336;align=left;spacingLeft=16;fontSize=15;fontColor=#E7E9EA;" value="Gómez" vertex="1">
          <mxGeometry x="424" y="289" width="592" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a-field-surname-label" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#71767B;fillColor=#16181C;" value="Apellidos" vertex="1">
          <mxGeometry x="436" y="281" width="60" height="16" as="geometry" />
        </mxCell>
        <mxCell id="a-field-role" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#2F3336;align=left;spacingLeft=16;fontSize=15;fontColor=#E7E9EA;" value="Visor" vertex="1">
          <mxGeometry x="424" y="357" width="592" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a-field-role-label" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#71767B;fillColor=#16181C;" value="Rol" vertex="1">
          <mxGeometry x="436" y="349" width="32" height="16" as="geometry" />
        </mxCell>
        <mxCell id="a-field-role-arrow" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#71767B;" value="▾" vertex="1">
          <mxGeometry x="984" y="369" width="24" height="28" as="geometry" />
        </mxCell>
        <mxCell id="a-field-password" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#2F3336;align=left;spacingLeft=16;fontSize=15;fontColor=#E7E9EA;" value="••••••••••" vertex="1">
          <mxGeometry x="424" y="425" width="592" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a-field-password-label" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#71767B;fillColor=#16181C;" value="Contraseña" vertex="1">
          <mxGeometry x="436" y="417" width="68" height="16" as="geometry" />
        </mxCell>
        <mxCell id="a-field-repeat" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#F4212E;align=left;spacingLeft=16;fontSize=15;fontColor=#E7E9EA;" value="••••••" vertex="1">
          <mxGeometry x="424" y="493" width="592" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a-field-repeat-label" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#F4212E;fillColor=#16181C;" value="Repetir contraseña" vertex="1">
          <mxGeometry x="436" y="485" width="112" height="16" as="geometry" />
        </mxCell>

        <!-- Panel flotante de errores, anclado al botón de alerta y abierto hacia arriba -->
        <mxCell id="a-panel" parent="1" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#16181C;strokeColor=#F4212E;align=left;verticalAlign=top;spacing=12;fontSize=13;fontColor=#E7E9EA;" value="&lt;b&gt;&lt;font color=&quot;#F4212E&quot;&gt;No se puede guardar: hay 3 errores&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;•&amp;nbsp;&amp;nbsp;Nombre de usuario: el campo es obligatorio&lt;br&gt;•&amp;nbsp;&amp;nbsp;Nombre: el campo es obligatorio&lt;br&gt;•&amp;nbsp;&amp;nbsp;Repetir contraseña: no coincide con la contraseña" vertex="1">
          <mxGeometry x="616" y="636" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a-panel-arrow" parent="1" style="shape=triangle;direction=south;whiteSpace=wrap;html=1;fillColor=#16181C;strokeColor=#F4212E;" value="" vertex="1">
          <mxGeometry x="924" y="756" width="16" height="10" as="geometry" />
        </mxCell>
        <mxCell id="a-panel-cover" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16181C;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="925" y="754" width="14" height="3" as="geometry" />
        </mxCell>

        <!-- Pie en edición: Alerta (solo con errores), Guardar y Descartar -->
        <mxCell id="a-footer-line" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F3336;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="120" y="768" width="920" height="1" as="geometry" />
        </mxCell>
        <mxCell id="a-btn-alert" parent="1" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry x="924" y="782" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a-badge" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F4212E;strokeColor=none;fontSize=10;fontStyle=1;fontColor=#FFFFFF;" value="3" vertex="1">
          <mxGeometry x="938" y="777" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="a-btn-save" parent="1" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry x="968" y="782" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a-btn-discard" parent="1" style="shape=image;html=1;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" value="" vertex="1">
          <mxGeometry x="1004" y="782" width="24" height="24" as="geometry" />
        </mxCell>

        <mxCell id="a-notes" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#16181C;strokeColor=#2F3336;fontColor=#E7E9EA;" value="&lt;b&gt;Errores de validación: panel abierto&lt;/b&gt;&lt;br&gt;&lt;br&gt;Al pulsar &lt;b&gt;Guardar&lt;/b&gt;, el editor pasa el formulario por su validador. Si alguna regla se rompe, &lt;b&gt;no se guarda&lt;/b&gt; y:&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Los campos afectados se marcan con borde y etiqueta en &lt;font color=&quot;#F4212E&quot;&gt;--color-danger&lt;/font&gt; (estado «Error»). No llevan texto de error propio.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Aparece en el pie el &lt;b&gt;botón de alerta&lt;/b&gt;, a la izquierda de Guardar, con una insignia roja con el número de errores.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; El &lt;b&gt;panel de errores se abre solo&lt;/b&gt; (panel flotante anclado al botón con &lt;i&gt;cdkConnectedOverlay&lt;/i&gt;, abierto hacia arriba, con la clase &lt;i&gt;floating-panel&lt;/i&gt;): un título con el número de errores y una línea por regla rota con el mensaje en el idioma actual, «Campo: qué se ha roto». Con parámetros, dice qué se esperaba y qué se ha introducido (por ejemplo, «Valor: se esperaba entre 1 y 100 y se ha introducido 150»).&lt;br&gt;&lt;br&gt;&lt;b&gt;Cierre&lt;/b&gt;: clic fuera, Escape o pulsar de nuevo el botón. El panel puede tapar campos mientras está abierto; al cerrarlo, los campos siguen marcados.&lt;br&gt;&lt;br&gt;&lt;b&gt;Accesibilidad&lt;/b&gt;: el botón lleva tooltip y nombre accesible con el número («3 errores»); el panel es &lt;i&gt;role=alert&lt;/i&gt;, así que los lectores de pantalla lo anuncian al abrirse." vertex="1">
          <mxGeometry x="1120" y="20" width="400" height="560" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

