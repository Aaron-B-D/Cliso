        <mxCell id="a-dialog" parent="1" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#16181C;strokeColor=#2F3336;" value="" vertex="1">
          <mxGeometry x="120" y="60" width="920" height="760" as="geometry" />
        </mxCell>

        <!-- Cabecera -->
        <mxCell id="a-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#E7E9EA;" value="Usuarios" vertex="1">
