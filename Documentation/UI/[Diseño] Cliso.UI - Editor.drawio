        <!-- Nota -->
        <mxCell id="notes" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#16181C;strokeColor=#2F3336;fontColor=#E7E9EA;" value="&lt;b&gt;Editor de visualizaciones (móvil, &amp;lt; 768 px)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mismo esquema que «Usuarios (móvil)»: modal a pantalla completa, lista y detalle en dos pasos, pie fijo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Previsualización&lt;/b&gt;: el visor y la lista de marcadores comparten la pantalla, y el conjunto se desplaza en vertical si no cabe. Con &lt;i&gt;+ Marcador&lt;/i&gt; activo, un toque sobre el modelo coloca un marcador numerado; tocar un marcador lo selecciona y resalta su fila.&lt;br&gt;&lt;br&gt;Cada fila de marcador mide al menos 44 px (objetivo táctil) con ✎ (editar) y ✕ (borrar).&lt;br&gt;&lt;br&gt;&lt;i&gt;Densidad compacta, como en escritorio.&lt;/i&gt;" vertex="1">
          <mxGeometry x="1240" y="40" width="340" height="360" as="geometry" />
        </mxCell>
