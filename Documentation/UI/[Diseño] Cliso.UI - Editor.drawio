        <!-- Nota -->
        <mxCell id="notes" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#16181C;strokeColor=#2F3336;fontColor=#E7E9EA;" value="&lt;b&gt;Editor de usuarios (móvil, &amp;lt; 768 px)&lt;/b&gt;&lt;br&gt;&lt;br&gt;El modal (MatDialog) ocupa &lt;b&gt;toda la pantalla&lt;/b&gt; (sin bordes redondeados en el borde de la pantalla ni redimensionado). No hay maximizar ni splitter; ✕ cierra.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dos pasos&lt;/b&gt; en lugar de dos columnas:&lt;br&gt;1. &lt;b&gt;Lista&lt;/b&gt;: buscador y fichas a ancho completo con ›.&lt;br&gt;2. &lt;b&gt;Detalle&lt;/b&gt;: al tocar una ficha (o Añadir, con el detalle en blanco). ← vuelve a la lista; el título pasa a ser el nombre de la ficha.&lt;br&gt;&lt;br&gt;Pestañas (General / Permisos) a ancho repartido. Campos en una columna.&lt;br&gt;&lt;br&gt;El pie (Añadir / Editar / Borrar; Guardar / Descartar en edición) queda fijo abajo, con iconos pequeños.&lt;br&gt;&lt;br&gt;&lt;i&gt;Desde 768 px vuelve el diseño de escritorio. Modelos y Visualizaciones siguen este mismo esquema.&lt;/i&gt;" vertex="1">
          <mxGeometry x="840" y="40" width="340" height="460" as="geometry" />
        </mxCell>
