# Copiar a .env (que no se sube a git) para cambiar los valores por defecto.

# Puerto del equipo desde el que se abre la aplicación (http://localhost:8080).
UI_PORT=8080

# Puerto del equipo en el que se publica la API (http://localhost:8000/docs) y, solo en modo MySQL, el de la base de datos.
API_PORT=8000
MYSQL_PORT=3307

# Fichero de configuración de la API (carpeta api/): settings.docker.json (SQLite) o settings.docker.mysql.json (MySQL).
CLISO_SETTINGS_FILE=settings.docker.json

# Solo modo MySQL. Debe coincidir con mysql_password de settings.docker.mysql.json.
# Solo 8.0: en 8.4 se eliminó el plugin de autenticación que usa la API.
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=cliso_dev
