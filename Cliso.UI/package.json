		"@angular/compiler-cli": "^20.3.0",
		"@types/jasmine": "~5.1.0",
		"@types/three": "0.182.0",
		"angular-eslint": "^20.7.0",
		"eslint": "^9.39.5",
		"jasmine-core": "~5.9.0",
		"karma": "~6.4.0",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.1.0",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.72.1"
	}
