{
	"name": "cliso.ui",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"lint": "eslint \"src/**/*.{ts,html}\""
	},
	"prettier": {
		"arrowParens": "always",
		"bracketSameLine": false,
