		"endOfLine": "auto",
		"printWidth": 130,
		"quoteProps": "as-needed",
		"singleQuote": true,
		"tabWidth": 2,
		"trailingComma": "none",
		"useTabs": true
	},
	"private": true,
	"dependencies": {
		"@angular/cdk": "^20.2.14",
		"@angular/common": "^20.3.0",
		"@angular/compiler": "^20.3.0",
		"@angular/core": "^20.3.0",
		"@angular/forms": "^20.3.0",
		"@angular/material": "^20.2.14",
		"@angular/platform-browser": "^20.3.0",
		"@angular/router": "^20.3.0",
		"@thatopen/components": "3.6.0",
		"@thatopen/fragments": "3.6.0",
		"bootstrap": "^5.3.8",
		"camera-controls": "3.1.2",
		"rxjs": "~7.8.0",
		"temporal-polyfill": "1.0.6",
		"three": "0.182.0",
		"tslib": "^2.3.0",
		"web-ifc": "0.0.77",
		"zone.js": "~0.15.0"
	},
	"devDependencies": {
		"@angular/build": "^20.3.23",
